# ZOI — contoh konfigurasi MODE ONLINE (Render + Neon). Nilai-nilai ini diisi di layar
# Environment milik Render, BUKAN sebagai file .env di repo. Lihat docs/DEPLOY_ONLINE.md.

ZOI_MODE=online

# Connection string Neon (postgresql://...). RAHASIA — jangan pernah menaruhnya di repo atau chat.
ZOI_DATABASE_URL=

# Kunci enkripsi rahasia di database (>= 32 karakter) — klik "Generate" di Render.
ZOI_SECRET_KEY=
# Token sekali pakai untuk membuat/mengganti kata sandi login (>= 16 karakter) — klik "Generate" di Render.
ZOI_SETUP_TOKEN=
# Token untuk workflow GitHub Actions "ZOI bangun" (>= 24 karakter) — klik "Generate" di Render. Kosong = nonaktif.
ZOI_WAKE_TOKEN=

# AI cloud gratis. API key TIDAK ditulis di sini: masukkan lewat Settings › AI Cloud setelah login.
ZOI_AI_PROVIDER=nvidia
ZOI_AI_FALLBACK=openrouter
ZOI_NVIDIA_MODEL=
ZOI_OPENROUTER_MODEL=

# Alamat publik. Di Render TIDAK perlu diisi (terbaca otomatis dari RENDER_EXTERNAL_URL).
# ZOI_PUBLIC_URL=https://zoi-xxxx.onrender.com
