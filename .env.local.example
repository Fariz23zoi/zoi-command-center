# ZOI — contoh konfigurasi MODE LOCAL (local server Windows)
# Salin menjadi .env di folder root repo, lalu jalankan:  python -m app.cli doctor

ZOI_MODE=local
ZOI_HOST=127.0.0.1
# Port 80 → aplikasi dibuka di http://127.0.0.1 . Jika port 80 dipakai program lain, ganti ke 8000.
ZOI_PORT=80
ZOI_DATA_DIR=./data
ZOI_LOG_LEVEL=INFO

# Mode local TIDAK boleh memakai mock. auto = ollama.
ZOI_AI_PROVIDER=auto
ZOI_OLLAMA_URL=http://127.0.0.1:11434
# Wajib diisi agar fitur AI aktif. ZOI tidak pernah mengunduh model sendiri.
# Contoh (unduh manual dulu dengan persetujuanmu):  ollama pull qwen3:8b
ZOI_OLLAMA_MODEL=

ZOI_AVATAR_MODE=auto

ZOI_CLIPPER_DIR=
ZOI_CLIPPER_PYTHON=
ZOI_BLUEPRINT_FILE=

ZOI_EXTRA_ALLOWED_HOSTS=
