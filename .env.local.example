# ZOI — contoh konfigurasi MODE LOCAL (local server Windows)
# Salin menjadi .env di folder root repo, lalu jalankan:  python -m app.cli doctor

ZOI_MODE=local
ZOI_HOST=127.0.0.1
# Port 80 → aplikasi dibuka di http://127.0.0.1 . Jika port 80 dipakai program lain, ganti ke 8000.
ZOI_PORT=80
ZOI_DATA_DIR=./data
ZOI_LOG_LEVEL=INFO

# Mode local TIDAK boleh memakai mock. auto = ollama.
ZOI_AI_PROVIDER=auto
ZOI_OLLAMA_URL=http://127.0.0.1:11434
# Wajib diisi agar fitur AI aktif. ZOI tidak pernah mengunduh model sendiri.
# Contoh (unduh manual dulu dengan persetujuanmu):  ollama pull qwen3:8b
ZOI_OLLAMA_MODEL=

# (Opsional) AI CLOUD GRATIS — bawaan mati. Bila diaktifkan, isi chat, memori, judul video, dan naskah dikirim ke
# NVIDIA/OpenRouter. API key TIDAK ditulis di sini: masukkan lewat Settings › AI Cloud.
# Lihat docs/MIGRATION_TO_LOCAL_SERVER.md bagian 5d.
# ZOI_AI_PROVIDER=nvidia
# ZOI_NVIDIA_MODEL=
# ZOI_AI_FALLBACK=openrouter
# ZOI_OPENROUTER_MODEL=

ZOI_AVATAR_MODE=auto

ZOI_CLIPPER_DIR=
ZOI_CLIPPER_PYTHON=
ZOI_BLUEPRINT_FILE=
# (Opsional) Folder tempat kamu sendiri menjalankan `npm install hyperframes` (butuh Node.js 22+ dan FFmpeg).
# Kosong = render HyperFrames nonaktif. ZOI tidak pernah memasang apa pun.
ZOI_HYPERFRAMES_DIR=

ZOI_EXTRA_ALLOWED_HOSTS=

# Suara (Phase 4) — opsional. ZOI tidak mengunduh model; siapkan sendiri (Settings > Suara).
# ZOI_STT: auto (= whisper di mode local) | whisper | none
ZOI_STT=auto
# Folder model faster-whisper (berisi model.bin & config.json), mis. D:\zoi-models\whisper-base
ZOI_WHISPER_MODEL_DIR=
# ZOI_TTS: auto (= piper di mode local) | piper | none. Tanpa Piper, ZOI memakai suara lokal Windows.
ZOI_TTS=auto
# Alamat server Piper yang dijalankan deploy\windows\voice.ps1
ZOI_PIPER_URL=http://127.0.0.1:5001

# ── Akses dari HP lewat Tailscale (opsional, docs/AKSES_HP.md) ─────────────────────────
# Alamat dari `tailscale serve status`, mis. https://laptop-zoi.tail1234.ts.net
ZOI_REMOTE_URL=
# (Disarankan) email/login akun Tailscale-mu; hanya akun ini yang boleh membuka ZOI dari jauh.
ZOI_REMOTE_USER=
