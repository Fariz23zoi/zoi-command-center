# ZOI — contoh konfigurasi MODE DEVELOPMENT
# Salin menjadi .env (di folder root repo). Semua variabel opsional; nilai di bawah adalah default.

ZOI_MODE=development
ZOI_HOST=127.0.0.1
ZOI_PORT=8000
ZOI_DATA_DIR=./data-dev
ZOI_LOG_LEVEL=INFO

# auto = mock di mode development. Jawaban mock selalu berlabel MOCK.
ZOI_AI_PROVIDER=auto
ZOI_MOCK_LATENCY_MS=300

ZOI_AVATAR_MODE=auto

# Opsional — path aplikasi lama di mesin ini (ZOI hanya MEMBACA, tidak pernah mengubah)
ZOI_CLIPPER_DIR=
ZOI_CLIPPER_PYTHON=
ZOI_BLUEPRINT_FILE=

# Tambahan host yang boleh dihubungi (dipisah koma), mis. IP mesin Ollama di jaringan rumah
ZOI_EXTRA_ALLOWED_HOSTS=
